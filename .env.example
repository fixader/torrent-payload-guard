TZ=Europe/Oslo

# Do not use localhost here. Use a Docker service name or the NAS IP.
# Optional: leave these blank to use the first-run setup wizard.
QBIT_URL=
QBIT_USERNAME=
QBIT_PASSWORD=

SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=
RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=

POLL_INTERVAL_SECONDS=30
ACTION_MODE=observe
DRY_RUN=true
DELETE_DATA=false
PAUSE_UNMAPPED=true
SONARR_CATEGORIES=sonarr
RADARR_CATEGORIES=radarr
STATUS_PORT=8080
UI_USERNAME=admin
# Optional: the first-run setup wizard requires you to create this password.
UI_PASSWORD=

# Optional override:
# DANGEROUS_EXTENSIONS=.exe,.scr,.bat,.cmd,.com,.msi,.msp,.ps1,.psm1,.vbs,.vbe,.js,.jse,.wsf,.wsh,.hta,.lnk,.jar,.reg,.dll,.apk
