TZ=Etc/UTC

# Leave connection details blank to use the first-run setup wizard.
# With the supplied host-network Compose file, 127.0.0.1 means the Docker host.
QBIT_URL=
QBIT_USERNAME=
QBIT_PASSWORD=

SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=

POLL_INTERVAL_SECONDS=30
ACTION_MODE=observe
DRY_RUN=true
DELETE_DATA=false
PAUSE_UNMAPPED=true
SONARR_CATEGORIES=sonarr
RADARR_CATEGORIES=radarr
UI_USERNAME=admin
# Optional: the first-run setup wizard requires you to create this password.
UI_PASSWORD=

# Optional override:
# DANGEROUS_EXTENSIONS=.exe,.scr,.bat,.cmd,.com,.msi,.msp,.ps1,.psm1,.vbs,.vbe,.js,.jse,.wsf,.wsh,.hta,.lnk,.jar,.reg,.dll,.apk
