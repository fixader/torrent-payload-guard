TZ=Europe/Oslo

# Do not use localhost here. Use a Docker service name or the NAS IP.
QBIT_URL=http://192.168.1.10:8081
QBIT_USERNAME=admin
QBIT_PASSWORD=change-me

SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=
RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=

POLL_INTERVAL_SECONDS=30
ACTION_MODE=observe
DRY_RUN=true
DELETE_DATA=false
PAUSE_UNMAPPED=true
SONARR_CATEGORIES=sonarr
RADARR_CATEGORIES=radarr
STATUS_PORT=8080
UI_USERNAME=admin
UI_PASSWORD=change-this-dashboard-password

# Optional override:
# DANGEROUS_EXTENSIONS=.exe,.scr,.bat,.cmd,.com,.msi,.msp,.ps1,.psm1,.vbs,.vbe,.js,.jse,.wsf,.wsh,.hta,.lnk,.jar,.reg,.dll,.apk
